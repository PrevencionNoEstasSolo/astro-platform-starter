  <script>
   // Theme toggle
    const toggleThemeBtn = document.getElementById("toggle-theme");
    const body = document.body;
    const header = document.getElementById("header");

    function setTheme(theme) {
      if (theme === "dark") {
        body.classList.add("dark");
        body.setAttribute("data-theme", "dark");
        header.classList.add("dark");
        toggleThemeBtn.innerHTML = '<i class="fas fa-sun"></i>';
      } else {
        body.classList.remove("dark");
        body.setAttribute("data-theme", "light");
        header.classList.remove("dark");
        toggleThemeBtn.innerHTML = '<i class="fas fa-moon"></i>';
      }
      localStorage.setItem("theme", theme);
    }

    toggleThemeBtn.addEventListener("click", () => {
      const currentTheme = body.getAttribute("data-theme");
      if (currentTheme === "light") {
        setTheme("dark");
      } else {
        setTheme("light");
      }
    });

    // Load theme from localStorage
    const savedTheme = localStorage.getItem("theme") || "light";
    setTheme(savedTheme);

    // Mobile menu toggle
    const menuButton = document.getElementById("menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    menuButton.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });

    // Cart sidebar toggle
    const cartButton = document.getElementById("cart-button");
    const cartSidebar = document.getElementById("cart-sidebar");
    const closeCartButton = document.getElementById("close-cart");
    const checkoutButton = document.getElementById("checkout-button");
    const checkoutModal = document.getElementById("checkout-modal");
    const closeCheckoutButton = document.getElementById("close-checkout");
    const checkoutForm = document.getElementById("checkout-form");
    const cartItemsContainer = document.getElementById("cart-items");
    const cartCount = document.getElementById("cart-count");
    const cartTotal = document.getElementById("cart-total");

    let cart = [];

    function updateCartUI() {
      cartCount.textContent = cart.length;
      if (cart.length === 0) {
        cartItemsContainer.innerHTML =
          '<p class="text-gray-500 text-center dark:text-gray-400">No hay productos en el carrito.</p>';
        checkoutButton.disabled = true;
        cartTotal.textContent = "$0";
        return;
      }
      checkoutButton.disabled = false;
      let total = 0;
      cartItemsContainer.innerHTML = "";
      cart.forEach((item, index) => {
        total += item.price;
        const itemDiv = document.createElement("div");
        itemDiv.className =
          "flex justify-between items-center border-b border-gray-200 dark:border-gray-700 pb-2";
        itemDiv.innerHTML = `
          <div>
            <p class="font-semibold text-gray-800 dark:text-gray-200">${item.name}</p>
            <p class="text-gray-600 text-sm dark:text-gray-400">Precio: $${item.price}</p>
          </div>
          <button aria-label="Eliminar ${item.name} del carrito" class="text-pink-700 hover:text-pink-900 focus:outline-none" data-index="${index}">
            <i class="fas fa-trash-alt"></i>
          </button>
        `;
        cartItemsContainer.appendChild(itemDiv);
      });
      cartTotal.textContent = `$${total.toFixed(2)}`;

      // Add event listeners to remove buttons
      const removeButtons = cartItemsContainer.querySelectorAll("button");
      removeButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const idx = e.currentTarget.getAttribute("data-index");
          cart.splice(idx, 1);
          updateCartUI();
        });
      });
    }

    cartButton.addEventListener("click", () => {
      cartSidebar.setAttribute("aria-hidden", "false");
      cartSidebar.classList.remove("translate-x-full");
      cartSidebar.classList.add("translate-x-0");
    });

    closeCartButton.addEventListener("click", () => {
      cartSidebar.setAttribute("aria-hidden", "true");
      cartSidebar.classList.remove("translate-x-0");
      cartSidebar.classList.add("translate-x-full");
    });

    // Add to cart buttons
    function addProductToCart(name, price) {
      cart.push({ name, price });
      updateCartUI();
      cartSidebar.setAttribute("aria-hidden", "false");
      cartSidebar.classList.remove("translate-x-full");
      cartSidebar.classList.add("translate-x-0");
    }

    const addToCartButtons = document.querySelectorAll(
      'button[aria-label^="Agregar"]'
    );
    addToCartButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const article = e.currentTarget.closest("article");
        const name = article.querySelector("h3").textContent;
        const priceText = article.querySelector("div.text-xl").textContent;
        const price = parseFloat(priceText.replace("$", ""));
        addProductToCart(name, price);
      });
    });

    // Checkout modal open
    checkoutButton.addEventListener("click", () => {
      checkoutModal.classList.remove("hidden");
    });

    // Checkout modal close
    closeCheckoutButton.addEventListener("click", () => {
      checkoutModal.classList.add("hidden");
    });

    // Checkout form submit with email notification simulation
    checkoutForm.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!checkoutForm.checkValidity()) {
        checkoutForm.reportValidity();
        return;
      }
      const name = checkoutForm.name.value;
      const email = checkoutForm.email.value;
      const total = cart.reduce((acc, item) => acc + item.price, 0).toFixed(2);
      alert(
        `Gracias por tu compra, ${name}! Se ha enviado un correo de confirmación a ${email} con el total de $${total}.`
      );
      // Simulate sending email (in real app, backend needed)
      console.log(`Enviando correo a ${email} con detalles del pedido...`);
      cart = [];
      updateCartUI();
      checkoutModal.classList.add("hidden");
    });

    // Filtering products
    const filterType = document.getElementById("filter-type");
    const filterBrand = document.getElementById("filter-brand");
    const filterPrice = document.getElementById("filter-price");
    const filterSkinTone = document.getElementById("filter-skin-tone");
    const productList = document.getElementById("product-list");

    function filterProducts() {
      const typeVal = filterType.value;
      const brandVal = filterBrand.value;
      const priceVal = filterPrice.value;
      const skinToneVal = filterSkinTone.value;

      const products = productList.querySelectorAll("article");
      products.forEach((product) => {
        const pType = product.getAttribute("data-type");
        const pBrand = product.getAttribute("data-brand");
        const pPrice = parseFloat(product.getAttribute("data-price"));
        const pSkinTones = product.getAttribute("data-skin-tone").split(" ");

        let show = true;

        if (typeVal && pType !== typeVal) show = false;
        if (brandVal && pBrand !== brandVal) show = false;
        if (priceVal) {
          if (priceVal === "0-20" && !(pPrice <= 20)) show = false;
          else if (priceVal === "21-50" && !(pPrice >= 21 && pPrice <= 50))
            show = false;
          else if (priceVal === "51-100" && !(pPrice >= 51 && pPrice <= 100))
            show = false;
          else if (priceVal === "100+" && !(pPrice > 100)) show = false;
        }
        if (skinToneVal && !pSkinTones.includes(skinToneVal)) show = false;

        product.style.display = show ? "flex" : "none";
      });
    }

    filterType.addEventListener("change", filterProducts);
    filterBrand.addEventListener("change", filterProducts);
    filterPrice.addEventListener("change", filterProducts);
    filterSkinTone.addEventListener("change", filterProducts);

    // Pop-up bienvenida
    const welcomePopup = document.getElementById("welcome-popup");
    const closeWelcomeBtn = document.getElementById("close-welcome");
    const welcomeForm = document.getElementById("welcome-form");
    const welcomeMessage = document.getElementById("welcome-message");

    function showWelcomePopup() {
      if (!localStorage.getItem("welcomeDismissed")) {
        welcomePopup.classList.remove("hidden");
      }
    }

    closeWelcomeBtn.addEventListener("click", () => {
      welcomePopup.classList.add("hidden");
      localStorage.setItem("welcomeDismissed", "true");
    });

    welcomeForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const emailInput = welcomeForm["welcome-email"];
      if (!emailInput.checkValidity()) {
        emailInput.reportValidity();
        return;
      }
      // Simulate saving email and giving discount
      welcomeMessage.textContent =
        "¡Gracias! Tu descuento del 10% ha sido activado. Revisa tu correo.";
      welcomeMessage.classList.remove("hidden");
      emailInput.value = "";
      setTimeout(() => {
        welcomePopup.classList.add("hidden");
        localStorage.setItem("welcomeDismissed", "true");
      }, 4000);
    });

    // Mostrar pop-up al cargar
    window.addEventListener("load", showWelcomePopup);

    // Seguimiento de pedidos
    const trackingForm = document.getElementById("tracking-form");
    const trackingResult = document.getElementById("tracking-result");

    trackingForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const orderNumber = trackingForm["order-number"].value.trim();
      if (!orderNumber) {
        trackingResult.textContent = "Por favor ingresa un número de pedido válido.";
        trackingResult.classList.remove("hidden");
        return;
      }
      // Simulación de estados de pedido
      const estados = [
        "Pedido recibido",
        "En preparación",
        "Enviado",
        "En camino",
        "Entregado",
      ];
      // Simular estado aleatorio basado en número de pedido
      const hash = orderNumber
        .split("")
        .reduce((acc, char) => acc + char.charCodeAt(0), 0);
      const estado = estados[hash % estados.length];
      trackingResult.textContent = `Estado del pedido #${orderNumber}: ${estado}`;
      trackingResult.classList.remove("hidden");
    });

    // Kits personalizados
    const kitForm = document.getElementById("kit-form");
    const kitPriceDisplay = document.getElementById("kit-price");

    function calculateKitPrice() {
      const baseSelect = kitForm["kit-base"];
      const labialSelect = kitForm["kit-labial"];
      const delineadorSelect = kitForm["kit-delineador"];

      let total = 0;
      if (baseSelect.value) {
        const option = baseSelect.options[baseSelect.selectedIndex];
        total += parseFloat(option.getAttribute("data-price")) || 0;
      }
      if (labialSelect.value) {
        const option = labialSelect.options[labialSelect.selectedIndex];
        total += parseFloat(option.getAttribute("data-price")) || 0;
      }
      if (delineadorSelect.value) {
        const option = delineadorSelect.options[delineadorSelect.selectedIndex];
        total += parseFloat(option.getAttribute("data-price")) || 0;
      }
      // 10% de descuento
      const discounted = total * 0.9;
      kitPriceDisplay.textContent = `Precio total: $${discounted.toFixed(2)}`;
      return discounted;
    }

    kitForm.addEventListener("change", calculateKitPrice);
    kitForm.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!kitForm.checkValidity()) {
        kitForm.reportValidity();
        return;
      }
      const base = kitForm["kit-base"].value;
      const labial = kitForm["kit-labial"].value;
      const delineador = kitForm["kit-delineador"].value;
      const price = calculateKitPrice();

      addProductToCart(`Kit personalizado: ${base}, ${labial}, ${delineador}`, price);
      alert("Kit personalizado añadido al carrito con 10% de descuento.");
      kitForm.reset();
      calculateKitPrice();
    });

    // Videos cortos en productos
    const videoButtons = document.querySelectorAll(".video-btn");
    const videoModal = document.getElementById("video-modal");
    const videoPlayer = document.getElementById("video-player");
    const closeVideoBtn = document.getElementById("close-video");

    videoButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const videoSrc = btn.getAttribute("data-video");
        if (videoSrc) {
          videoPlayer.src = videoSrc;
          videoModal.classList.remove("hidden");
          videoPlayer.play();
        }
      });
    });

    closeVideoBtn.addEventListener("click", () => {
      videoPlayer.pause();
      videoPlayer.currentTime = 0;
      videoPlayer.src = "";
      videoModal.classList.add("hidden");
    });

    // Probador virtual
    const uploadPhotoInput = document.getElementById("upload-photo");
    const userPhoto = document.getElementById("user-photo");
    const virtualLipstick = document.getElementById("virtual-lipstick");
    const virtualEyeshadow = document.getElementById("virtual-eyeshadow");
    const applyVirtualBtn = document.getElementById("apply-virtual-makeup");
    const resetVirtualBtn = document.getElementById("reset-virtual-makeup");
    const virtualCanvas = document.getElementById("virtual-canvas");
    const ctx = virtualCanvas.getContext("2d");

    let originalImage = null;

    uploadPhotoInput.addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (event) {
        userPhoto.src = event.target.result;
        userPhoto.classList.remove("hidden");
        originalImage = new Image();
        originalImage.onload = () => {
          virtualCanvas.width = originalImage.width;
          virtualCanvas.height = originalImage.height;
          virtualCanvas.style.display = "block";
          ctx.clearRect(0, 0, virtualCanvas.width, virtualCanvas.height);
          ctx.drawImage(originalImage, 0, 0);
        };
        originalImage.src = event.target.result;
      };
      reader.readAsDataURL(file);
    });

    function applyMakeup() {
      if (!originalImage) return;
      ctx.clearRect(0, 0, virtualCanvas.width, virtualCanvas.height);
      ctx.drawImage(originalImage, 0, 0);

      // Simple overlay for labial: draw a semi-transparent ellipse on lips area
      const lipColor = virtualLipstick.value;
      if (lipColor) {
        ctx.fillStyle = lipColor + "88"; // semi-transparent
        // Approximate lips area (center bottom)
        const centerX = virtualCanvas.width / 2;
        const centerY = (virtualCanvas.height * 3) / 4;
        ctx.beginPath();
        ctx.ellipse(centerX, centerY, virtualCanvas.width / 6, virtualCanvas.height / 20, 0, 0, 2 * Math.PI);
        ctx.fill();
      }

      // Simple overlay for eyeshadow: draw semi-transparent rectangles on eyes area
      const eyeColor = virtualEyeshadow.value;
      if (eyeColor) {
        ctx.fillStyle = eyeColor + "88"; // semi-transparent
        // Approximate eyes area (top center left and right)
        const eyeWidth = virtualCanvas.width / 8;
        const eyeHeight = virtualCanvas.height / 20;
        const eyeY = virtualCanvas.height / 3;
        const leftEyeX = virtualCanvas.width / 3 - eyeWidth / 2;
        const rightEyeX = (virtualCanvas.width * 2) / 3 - eyeWidth / 2;
        ctx.fillRect(leftEyeX, eyeY, eyeWidth, eyeHeight);
        ctx.fillRect(rightEyeX, eyeY, eyeWidth, eyeHeight);
      }
    }

    applyVirtualBtn.addEventListener("click", () => {
      if (!originalImage) {
        alert("Por favor, sube una foto primero.");
        return;
      }
      applyMakeup();
    });

    resetVirtualBtn.addEventListener("click", () => {
      if (!originalImage) return;
      ctx.clearRect(0, 0, virtualCanvas.width, virtualCanvas.height);
      ctx.drawImage(originalImage, 0, 0);
      virtualLipstick.value = "";
      virtualEyeshadow.value = "";
    });

    // Newsletter form
    const newsletterForm = document.getElementById("newsletter-form");
    const newsletterMessage = document.getElementById("newsletter-message");

    newsletterForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const emailInput = newsletterForm["newsletter-email"];
      if (!emailInput.checkValidity()) {
        emailInput.reportValidity();
        return;
      }
      newsletterMessage.textContent =
        "¡Gracias por suscribirte! Pronto recibirás nuestros consejos y novedades.";
      newsletterMessage.classList.remove("hidden");
      emailInput.value = "";
      setTimeout(() => {
        newsletterMessage.classList.add("hidden");
      }, 6000);
    });

    // Blog read more modal
    const blogModal = document.getElementById("blog-modal");
    const blogModalTitle = document.getElementById("blog-modal-title");
    const blogModalContent = document.getElementById("blog-modal-content");
    const closeBlogModalBtn = document.getElementById("close-blog-modal");
    const readMoreButtons = document.querySelectorAll(".read-more-btn");

    readMoreButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const title = btn.getAttribute("data-title");
        const content = btn.getAttribute("data-content");
        blogModalTitle.textContent = title;
        blogModalContent.textContent = content;
        blogModal.classList.remove("hidden");
      });
    });

    closeBlogModalBtn.addEventListener("click", () => {
      blogModal.classList.add("hidden");
    });

    // Perfil de usuario
    const profileButton = document.getElementById("profile-button");
    const profileSection = document.getElementById("usuario");
    const closeProfileBtn = document.getElementById("close-profile");
    const profileEmail = document.getElementById("profile-email");
    const profilePhoto = document.getElementById("profile-photo");
    const profileOrdersList = document.getElementById("profile-orders");
    const profilePedidosList = document.getElementById("profile-pedidos");

    // Simulación de datos de usuario
    const userData = {
      email: "usuario@ejemplo.com",
      photo: "https://placehold.co/128x128/png?text=Perfil",
      historialCompras: [
        { id: "12345", date: "2024-05-10", total: 85.0 },
        { id: "12344", date: "2024-04-28", total: 45.0 },
        { id: "12343", date: "2024-04-15", total: 120.0 },
      ],
      pedidos: [
        { id: "12345", date: "2024-05-10", total: 85.0, status: "Entregado" },
        { id: "12346", date: "2024-06-01", total: 60.0, status: "En camino" },
      ],
    };

    function openProfile() {
      profileEmail.textContent = userData.email;
      profilePhoto.src = userData.photo;

      // Limpiar listas
      profileOrdersList.innerHTML = "";
      profilePedidosList.innerHTML = "";

      // Agregar historial de compras
      userData.historialCompras.forEach((order) => {
        const li = document.createElement("li");
        li.className = "py-4 flex justify-between items-center";
        li.innerHTML = `
          <div>
            <p class="font-semibold text-gray-800 dark:text-gray-200">Pedido #${order.id}</p>
            <p class="text-gray-600 text-sm dark:text-gray-400">Fecha: ${order.date}</p>
          </div>
          <div class="text-pink-700 font-semibold">$${order.total.toFixed(2)}</div>
        `;
        profileOrdersList.appendChild(li);
      });

      // Agregar pedidos
      userData.pedidos.forEach((pedido) => {
        const li = document.createElement("li");
        li.className = "py-4 flex justify-between items-center";
        li.innerHTML = `
          <div>
            <p class="font-semibold text-gray-800 dark:text-gray-200">Pedido #${pedido.id}</p>
            <p class="text-gray-600 text-sm dark:text-gray-400">Fecha: ${pedido.date}</p>
            <p class="text-gray-600 text-sm dark:text-gray-400">Estado: ${pedido.status}</p>
          </div>
          <div class="text-pink-700 font-semibold">$${pedido.total.toFixed(2)}</div>
        `;
        profilePedidosList.appendChild(li);
      });

      profileSection.style.display = "block";
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function closeProfile() {
      profileSection.style.display = "none";
    }

    profileButton.addEventListener("click", openProfile);
    closeProfileBtn.addEventListener("click", closeProfile);
  </script>
 </body>
</html>
